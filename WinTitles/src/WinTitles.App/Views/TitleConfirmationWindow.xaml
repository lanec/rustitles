<Window x:Class="WinTitles.App.Views.TitleConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Title" Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#282a36" Foreground="#f8f8f2"
        ResizeMode="CanResizeWithGrip">
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#f8f8f2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#44475a"/>
            <Setter Property="Foreground" Value="#f8f8f2"/>
            <Setter Property="BorderBrush" Value="#6272a4"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#6272a4"/>
            <Setter Property="Foreground" Value="#f8f8f2"/>
            <Setter Property="BorderBrush" Value="#6272a4"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#f8f8f2"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#44475a"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#383a4a"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="🎬 Subtitle Search - Confirm Title" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="We couldn't find subtitles automatically. Please confirm or correct the title." 
                       Foreground="#6272a4" Margin="0,5,0,0"/>
        </StackPanel>
        
        <!-- Original Filename -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Original Filename:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBlock x:Name="OriginalFileNameText" Text="" TextWrapping="Wrap" 
                       Foreground="#8be9fd" FontFamily="Consolas"/>
        </StackPanel>
        
        <!-- AI Suggestions -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="🤖 AI Suggestions (click to use):" FontWeight="SemiBold" Margin="0,0,0,5"/>
        </StackPanel>
        
        <ListBox x:Name="SuggestionsListBox" Grid.Row="3" 
                 Background="#383a4a" BorderBrush="#6272a4"
                 SelectionChanged="SuggestionsListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding YearDisplay}" Foreground="#ffb86c"/>
                        <TextBlock Text="{Binding EpisodeDisplay}" Foreground="#50fa7b" Margin="10,0,0,0"/>
                        <TextBlock Text="{Binding TypeDisplay}" Foreground="#6272a4" Margin="10,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <!-- Manual Input -->
        <StackPanel Grid.Row="4" Margin="0,15,0,15">
            <TextBlock Text="Or enter title manually:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox x:Name="TitleTextBox" Grid.Column="0" Margin="0,0,10,0"/>
                <TextBox x:Name="YearTextBox" Grid.Column="1" Width="60" Margin="0,0,10,0" 
                         ToolTip="Year (optional)"/>
                <TextBox x:Name="SeasonTextBox" Grid.Column="2" Width="40" Margin="0,0,5,0"
                         ToolTip="Season"/>
                <TextBox x:Name="EpisodeTextBox" Grid.Column="3" Width="40"
                         ToolTip="Episode"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock Text="Title" Foreground="#6272a4" Width="180"/>
                <TextBlock Text="Year" Foreground="#6272a4" Width="70"/>
                <TextBlock Text="S" Foreground="#6272a4" Width="45"/>
                <TextBlock Text="E" Foreground="#6272a4"/>
            </StackPanel>
        </StackPanel>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SkipButton" Content="Skip" Margin="0,0,10,0" 
                    Background="#ff5555" Click="SkipButton_Click"/>
            <Button x:Name="SearchButton" Content="🔍 Search" 
                    Background="#50fa7b" Foreground="#282a36" Click="SearchButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
