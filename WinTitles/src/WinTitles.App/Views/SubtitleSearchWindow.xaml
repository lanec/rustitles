<Window x:Class="WinTitles.App.Views.SubtitleSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search Subtitles" Height="550" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#282A36"
        ResizeMode="CanResizeWithGrip">
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F8F8F2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#44475A"/>
            <Setter Property="Foreground" Value="#F8F8F2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="#F8F8F2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#44475A"/>
            <Setter Property="Foreground" Value="#F8F8F2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#BD93F9"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header with file info -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Search Subtitles" FontSize="18" FontWeight="Bold" Foreground="#BD93F9"/>
            <TextBlock x:Name="FileNameText" Text="" Foreground="#6272A4" FontSize="12" Margin="0,5,0,0"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        
        <!-- Search box -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBox x:Name="SearchBox" Grid.Column="0" 
                     KeyDown="SearchBox_KeyDown"
                     ToolTip="Enter movie/show name to search"/>
            <Button x:Name="AISearchButton" Grid.Column="1" Content="🤖 AI Suggest" 
                    Click="AISearch_Click" Margin="10,0,0,0"
                    ToolTip="Use AI to suggest a better search query"/>
            <Button Grid.Column="2" Content="🔍 Search" Click="Search_Click" 
                    Margin="10,0,0,0" Style="{StaticResource PrimaryButton}"/>
        </Grid>
        
        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="2" Text="Enter a search term and click Search" 
                   Foreground="#6272A4" FontSize="12" Margin="0,0,0,10"/>
        
        <!-- Results list -->
        <Border Grid.Row="3" Background="#21222C" CornerRadius="8">
            <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                     SelectionChanged="ResultsList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#282A36" CornerRadius="4" Padding="12" Margin="5,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Title -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding FileName}" 
                                           Foreground="#F8F8F2" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                
                                <!-- Rating/Downloads -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="⬇" Foreground="#50FA7B" Margin="0,0,3,0"/>
                                    <TextBlock Text="{Binding DownloadsFormatted}" Foreground="#50FA7B" FontSize="12"/>
                                </StackPanel>
                                
                                <!-- Details -->
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DetailsLine}" 
                                           Foreground="#6272A4" FontSize="11" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#44475A"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#383A46"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>
        
        <!-- Footer with download button -->
        <Grid Grid.Row="4" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock x:Name="SelectedText" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="#6272A4" FontSize="12"/>
            
            <Button Grid.Column="1" Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0"/>
            <Button x:Name="DownloadButton" Grid.Column="2" Content="⬇ Download Selected" 
                    Click="Download_Click" Style="{StaticResource PrimaryButton}"
                    IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
