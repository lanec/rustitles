<Window x:Class="WinTitles.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:WinTitles.Core.Models;assembly=WinTitles.Core"
        mc:Ignorable="d"
        Title="WinTitles" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#282A36">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#44475A"/>
            <Setter Property="Foreground" Value="#F8F8F2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#6272A4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#BD93F9"/>
            <Setter Property="Foreground" Value="#282A36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF5555"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#21222C" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="WinTitles" FontSize="24" FontWeight="Bold" Foreground="#BD93F9"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="#6272A4" Margin="0,5,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⚙ Settings" Margin="0,0,10,0" Click="SettingsButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Progress Section -->
        <Border Grid.Row="1" Background="#44475A" Padding="20" Visibility="{Binding TotalJobs, Converter={StaticResource VisibleIfNotZero}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Foreground="#F8F8F2" FontSize="14">
                            <Run Text="Downloading: "/>
                            <Run Text="{Binding CompletedJobs, Mode=OneWay}"/>
                            <Run Text=" of "/>
                            <Run Text="{Binding TotalJobs, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding CurrentItem}" Foreground="#6272A4" Margin="0,5,0,0"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding PauseDownloadsCommand}" Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="⏸ Pause"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Content" Value="▶ Resume"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="↻ Retry Failed" Command="{Binding RetryFailedCommand}" 
                                Visibility="{Binding FailedJobs, Converter={StaticResource VisibleIfNotZero}}"/>
                    </StackPanel>
                </Grid>
                
                <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="8" 
                             Margin="0,15,0,0" Background="#21222C" Foreground="#BD93F9"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content - State-aware -->
        <Grid Grid.Row="2" Margin="20">
            
            <!-- IDLE STATE: Show action buttons and welcome -->
            <Grid Visibility="{Binding WorkflowState, Converter={StaticResource WorkflowStateToVisibility}, ConverterParameter=Idle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <Button Content="📁 Scan Folder" Command="{Binding ScanFolderCommand}" Margin="0,0,10,0"/>
                    <Button Content="📺 Scan Plex" Command="{Binding ScanPlexLibraryCommand}" Margin="0,0,10,0" 
                            Style="{StaticResource PrimaryButton}"/>
                    <Button x:Name="PlexServiceButton" 
                            Content="{Binding PlexServiceRunning, Converter={StaticResource PlexButtonText}}" 
                            Click="PlexServiceButton_Click" Margin="0,0,10,0"/>
                </StackPanel>
                
                <Border Grid.Row="1" Background="#21222C" CornerRadius="8" Padding="40">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Ready to Scan" FontSize="24" Foreground="#F8F8F2" HorizontalAlignment="Center"/>
                        <TextBlock Text="Click 'Scan Plex' to discover media and find missing subtitles." 
                                   Foreground="#6272A4" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="The scan will show you ALL items and let you review before downloading." 
                                   Foreground="#6272A4" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- SCANNING STATE: Show progress -->
            <Grid Visibility="{Binding WorkflowState, Converter={StaticResource WorkflowStateToVisibility}, ConverterParameter=Scanning}">
                <Border Background="#21222C" CornerRadius="8" Padding="40">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Scanning..." FontSize="24" Foreground="#F8F8F2" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ScanPhase}" Foreground="#BD93F9" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="16"/>
                        <TextBlock Text="{Binding CurrentItem}" Foreground="#6272A4" HorizontalAlignment="Center" Margin="0,5,0,20" 
                                   TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                        
                        <ProgressBar Value="{Binding ScanProgress}" Minimum="0" Maximum="100" Height="8" Width="400"
                                     Background="#44475A" Foreground="#BD93F9"/>
                        
                        <TextBlock HorizontalAlignment="Center" Margin="0,10,0,20" Foreground="#6272A4">
                            <Run Text="{Binding ScanCurrent, Mode=OneWay}"/>
                            <Run Text=" of "/>
                            <Run Text="{Binding ScanTotal, Mode=OneWay}"/>
                            <Run Text=" items"/>
                        </TextBlock>
                        
                        <Button Content="Cancel" Command="{Binding CancelScanCommand}" Style="{StaticResource DangerButton}"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- REVIEW STATE: Show scanned items with selection -->
            <Grid Visibility="{Binding WorkflowState, Converter={StaticResource WorkflowStateToVisibility}, ConverterParameter=Review}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Summary bar -->
                <Border Grid.Row="0" Background="#44475A" CornerRadius="4" Padding="15" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Foreground="#F8F8F2" VerticalAlignment="Center">
                            <Run Text="Found "/>
                            <Run Text="{Binding ScannedItems.Count, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text=" items  •  "/>
                            <Run Text="{Binding MissingCount, Mode=OneWay}" FontWeight="Bold" Foreground="#FFB86C"/>
                            <Run Text=" missing subtitles  •  "/>
                            <Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="Bold" Foreground="#50FA7B"/>
                            <Run Text=" selected"/>
                        </TextBlock>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Select Missing" Command="{Binding SelectMissingCommand}" Margin="0,0,10,0"/>
                            <Button Content="Deselect All" Command="{Binding DeselectAllCommand}" Margin="0,0,10,0"/>
                            <Button Content="▶ Download Selected" Command="{Binding StartDownloadsCommand}" 
                                    Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Action bar -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="📁 New Scan" Command="{Binding ClearActivityCommand}" Margin="0,0,10,0"/>
                </StackPanel>
                
                <!-- Scanned items list -->
                <Border Grid.Row="2" Background="#21222C" CornerRadius="8">
                    <ListBox ItemsSource="{Binding ScannedItems}" Background="Transparent" BorderThickness="0"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             x:Name="ScannedItemsListBox">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#282A36" CornerRadius="4" Padding="10" Margin="5,2">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="🤖 Get AI Search Suggestions" 
                                                      Click="AISearchSuggestions_Click"
                                                      Tag="{Binding}"/>
                                            <MenuItem Header="🔍 Manual Search..." 
                                                      Click="ManualSearch_Click"
                                                      Tag="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="📋 Copy File Path" 
                                                      Click="CopyFilePath_Click"
                                                      Tag="{Binding}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" 
                                                  VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        
                                        <TextBlock Grid.Column="1" Text="{Binding TypeIcon}" FontSize="16" 
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Foreground="#F8F8F2" FontSize="13"/>
                                            <TextBlock Text="{Binding FilePath}" Foreground="#44475A" FontSize="11" 
                                                       TextTrimming="CharacterEllipsis" MaxWidth="450"
                                                       ToolTip="{Binding FilePath}"/>
                                        </StackPanel>
                                        
                                        <TextBlock Grid.Column="3" Text="{Binding StatusText}" 
                                                   Foreground="{Binding StatusColor}" 
                                                   VerticalAlignment="Center" FontSize="12"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
            </Grid>
            
            <!-- DOWNLOADING/PAUSED STATE: Show queue progress -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WorkflowState}" Value="{x:Static models:WorkflowState.Downloading}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding WorkflowState}" Value="{x:Static models:WorkflowState.Paused}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Progress bar -->
                <Border Grid.Row="0" Background="#44475A" CornerRadius="4" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Foreground="#F8F8F2" FontSize="14">
                                    <Run Text="Downloading: "/>
                                    <Run Text="{Binding CompletedJobs, Mode=OneWay}" FontWeight="Bold"/>
                                    <Run Text=" of "/>
                                    <Run Text="{Binding TotalJobs, Mode=OneWay}"/>
                                    <Run Text="  •  "/>
                                    <Run Text="{Binding FailedJobs, Mode=OneWay}" Foreground="#FF5555"/>
                                    <Run Text=" failed  •  " Foreground="#FF5555"/>
                                    <Run Text="{Binding ActiveJobs, Mode=OneWay}" Foreground="#FFD700"/>
                                    <Run Text=" active" Foreground="#FFD700"/>
                                </TextBlock>
                                <TextBlock Text="{Binding EtaText}" Foreground="#6272A4" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="🤖 Analyze" Command="{Binding AnalyzeErrorsAsyncCommand}" 
                                        Margin="0,0,10,0" Visibility="{Binding FailedJobs, Converter={StaticResource VisibleIfNotZero}}"
                                        ToolTip="Analyze errors with AI"/>
                                <Button Command="{Binding PauseDownloadsCommand}" Margin="0,0,10,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Content" Value="⏸ Pause"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                    <Setter Property="Content" Value="▶ Resume"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="✕ Cancel" Command="{Binding CancelDownloadsCommand}" Style="{StaticResource DangerButton}"/>
                            </StackPanel>
                        </Grid>
                        
                        <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="8" 
                                     Margin="0,10,0,0" Background="#21222C" Foreground="#BD93F9"/>
                    </StackPanel>
                </Border>
                
                <!-- Queue items -->
                <Border Grid.Row="1" Background="#21222C" CornerRadius="8">
                    <ListBox ItemsSource="{Binding QueueItems}" Background="Transparent" BorderThickness="0"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#282A36" CornerRadius="4" Padding="10" Margin="5,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="16" 
                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#F8F8F2" 
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        
                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" 
                                                   Foreground="{Binding StatusColor}" 
                                                   VerticalAlignment="Center" FontSize="12"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
            </Grid>
            
            <!-- COMPLETE STATE: Show results with retry option -->
            <Grid Visibility="{Binding WorkflowState, Converter={StaticResource WorkflowStateToVisibility}, ConverterParameter=Complete}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Summary -->
                <Border Grid.Row="0" Background="#44475A" CornerRadius="4" Padding="15" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Foreground="#F8F8F2" FontSize="14" VerticalAlignment="Center">
                            <Run Text="Complete: "/>
                            <Run Text="{Binding CompletedJobs, Mode=OneWay}" FontWeight="Bold" Foreground="#50FA7B"/>
                            <Run Text=" downloaded  •  "/>
                            <Run Text="{Binding FailedJobs, Mode=OneWay}" FontWeight="Bold" Foreground="#FF5555"/>
                            <Run Text=" failed"/>
                        </TextBlock>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="🤖 Analyze Errors" Command="{Binding AnalyzeErrorsAsyncCommand}" 
                                    Margin="0,0,10,0" Visibility="{Binding FailedJobs, Converter={StaticResource VisibleIfNotZero}}"
                                    ToolTip="Use AI to analyze errors and get recommendations"/>
                            <Button Content="↻ Retry Failed" Command="{Binding RetryFailedAsyncCommand}" 
                                    Margin="0,0,10,0" Visibility="{Binding FailedJobs, Converter={StaticResource VisibleIfNotZero}}"/>
                            <Button Content="📁 New Scan" Command="{Binding ClearActivityCommand}" 
                                    Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Results list -->
                <Border Grid.Row="1" Background="#21222C" CornerRadius="8">
                    <ListBox ItemsSource="{Binding QueueItems}" Background="Transparent" BorderThickness="0"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#282A36" CornerRadius="4" Padding="10" Margin="5,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="16" 
                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Foreground="#F8F8F2" FontSize="13"/>
                                            <TextBlock Text="{Binding Error}" Foreground="#FF5555" FontSize="11"
                                                       Visibility="{Binding Error, Converter={StaticResource VisibleIfNotNull}}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                                        </StackPanel>
                                        
                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" 
                                                   Foreground="{Binding StatusColor}" 
                                                   VerticalAlignment="Center" FontSize="12"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
            </Grid>
            
        </Grid>
        
        <!-- Footer -->
        <Border Grid.Row="3" Background="#21222C" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Foreground="#50FA7B" Text="● OpenSubtitles API"/>
                    
                    <TextBlock Margin="20,0,0,0" Foreground="#6272A4">
                        <Run Text="Webhook Server: "/>
                        <Run Text="{Binding PlexServiceRunning, Converter={StaticResource PlexStatusText}}"
                             Foreground="{Binding PlexServiceRunning, Converter={StaticResource BoolToColor}}"/>
                    </TextBlock>
                </StackPanel>
                
                <TextBlock Grid.Column="1" Text="WinTitles v1.0" Foreground="#44475A"/>
            </Grid>
        </Border>
    </Grid>
</Window>
